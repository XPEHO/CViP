{
  "name": "backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../.env src/server.js",
    "start": "node src/server.js",
    "lint": "eslint .",
    "test": "node --env-file-if-exists=../.env --test",
    "test:coverage": "mkdir -p coverage && node --env-file-if-exists=../.env --test --experimental-test-coverage --test-coverage-include='src/**' --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info",
    "migrate": "node-pg-migrate -m migrations --migration-file-language sql --envPath ../.env",
    "migrate:up": "npm run migrate -- up",
    "migrate:down": "npm run migrate -- down",
    "migrate:create": "npm run migrate -- create"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "supertest": "^7.3.1"
  }
}
