{
  "name": "cvip_backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "typecheck": "tsc --noEmit",
    "predev": "npm run build",
    "dev": "run-p dev:tsc dev:node",
    "dev:tsc": "tsc --watch --preserveWatchOutput",
    "dev:node": "node --watch --env-file-if-exists=../.env dist/server.js",
    "start": "node --env-file-if-exists=../.env dist/server.js",
    "lint": "eslint .",
    "pretest": "npm run build",
    "test": "node --env-file-if-exists=../.env --test \"dist/**/*.test.js\"",
    "test:coverage": "npm run build && c8 node --env-file-if-exists=../.env --test \"dist/**/*.test.js\"",
    "migrate": "node-pg-migrate -m migrations --migration-file-language sql --envPath ../.env",
    "migrate:up": "npm run migrate -- up",
    "migrate:down": "npm run migrate -- down",
    "migrate:create": "npm run migrate -- create"
  },
  "dependencies": {
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^1.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testcontainers/postgresql": "^12.2.2",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/swagger-ui-express": "^4.1.8",
    "c8": "^12.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-jsdoc": "^65.5.4",
    "globals": "^17.14.0",
    "npm-run-all2": "^9.1.0",
    "testcontainers": "^12.2.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
