{
  "name": "cvip_playwright",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Tests de bout en bout de l'interface CViP (Playwright) et contrôle d'accessibilité (axe-core)",
  "scripts": {
    "lint": "eslint .",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:ci": "playwright test",
    "report": "playwright show-report report/html",
    "install:browsers": "playwright install chromium webkit",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.1",
    "@tsconfig/node26": "^26.0.2",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-plugin-jsdoc": "^65.5.4",
    "globals": "^17.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
