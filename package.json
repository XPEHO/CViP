{
  "name": "cvip",
  "private": true,
  "workspaces": [
    "cvip_backend",
    "cvip_frontend",
    "cvip_cucumber",
    "cvip_playwright"
  ],
  "scripts": {
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "dev": "npm-run-all --parallel dev:*",
    "dev:backend": "npm run dev -w cvip_backend",
    "dev:frontend": "npm run dev -w cvip_frontend",
    "build": "npm run build -w cvip_frontend",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "db:migrate": "npm run migrate:up -w cvip_backend",
    "prepare": "node scripts/prepare.mjs",
    "test:scripts": "node --test scripts/*.test.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "e2e:api": "npm run e2e -w cvip_cucumber",
    "e2e:ui": "npm run e2e -w cvip_playwright"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "lefthook": "^2.2.2",
    "npm-run-all2": "^9.0.4",
    "prettier": "^3.10.1"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
