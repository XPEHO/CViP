# PostgreSQL (used by docker-compose and the backend)
POSTGRES_USER=<<USER>>
POSTGRES_PASSWORD=<<PASSWORD>>
POSTGRES_DB=<<DB_NAME>>
POSTGRES_PORT=<<PORT>>

# Backend
PORT=<<BACKEND_PORT>>
DATABASE_URL=postgres://<<USER>>:<<PASSWORD>>@localhost:<<PORT>>/<<DB_NAME>>

# Containerized frontend (docker compose)
FRONTEND_PORT=<<FRONTEND_PORT>>
